{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.skillry/skillry",
  "title": "Skillry MCP",
  "description": "Search, preview, and install curated creative Agent Skills inside Claude Code, Codex & Cursor.",
  "version": "0.2.3",
  "websiteUrl": "https://skillry.dev/mcp",
  "repository": {
    "url": "https://github.com/yihui-dev/skillry-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://skillry.dev/apple-touch-icon.png",
      "mimeType": "image/png",
      "sizes": [
        "180x180"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "skillry-cli",
      "version": "0.2.3",
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
